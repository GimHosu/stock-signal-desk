# Stock Signal Desk — NAS(Docker) 설정 파일 예시
# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요. .env 는 절대 다른 곳에 공유하지 마세요.

# ── 필수 ──
# 앱 접속 비밀번호 (직접 정하기)
APP_PASSWORD=
# 텔레그램 알림의 '앱 열기' 링크
APP_URL=https://finance.hosu.me/
# 하위 경로로 서비스할 때만 사용 (예: https://hosu.me/finance → /finance). 서브도메인이면 비워 둡니다.
BASE_PATH=

# ── 텔레그램 알림 ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 실적 일정 & 뉴스 (finnhub.io 무료 키) ──
FINNHUB_API_KEY=

# ── 선택 ──
# S&P 500 밖 종목의 재무 정보 (SEC 규칙: "이름 이메일")
SEC_USER_AGENT=
# 뉴스 번역을 DeepL 공식 API로 (없으면 Google 무료 번역)
DEEPL_API_KEY=

# ── 토스증권 보유 종목 동기화 (조회만 하고 주문은 하지 않습니다) ──
# 토스증권 WTS > 설정 > Open API 에서 발급. 허용 IP 에 집(NAS)의 공인 IP 를 등록해야 합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 자동 동기화 시각 (UTC, 평일). 기본 21:45 = 한국 06:45, 아침 알림 직전
# TOSS_SYNC_UTC=21:45
